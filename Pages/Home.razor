@page "/"
@inject IEntryRepository Repo
@inject NavigationManager Nav
@inject SyncStateService SyncState
@implements IDisposable

<PageTitle>TrakingTool — Dashboard</PageTitle>

<MudStack Spacing="6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h4">Dashboard</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_oggi.ToString("dddd d MMMM yyyy")</MudText>
        </div>
        <MudButton StartIcon="@Icons.Material.Outlined.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("entries?new=1"))">
            Nuova attività
        </MudButton>
    </MudStack>

    <MudGrid>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="tt-card tt-stat-card pa-4" @onclick="@(() => Nav.NavigateTo("entries?stato=Aperta"))">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Aperte</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_stats.Aperte</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="tt-card tt-stat-card pa-4" @onclick="@(() => Nav.NavigateTo("entries?stato=InCorso"))">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">In corso</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_stats.InCorso</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="tt-card tt-stat-card pa-4" @onclick="@(() => Nav.NavigateTo($"entries?month={_oggi:yyyy-MM}"))">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Mese corrente</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_stats.MeseCorrente</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="tt-card tt-stat-card pa-4" @onclick="@(() => Nav.NavigateTo("entries"))">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Totale</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_stats.Totale</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="6">
            @RenderList("In corso", "Riprendi da dove avevi lasciato.", _inCorso, Stato.InCorso)
        </MudItem>
        <MudItem xs="12" md="6">
            @RenderList("Aperte", "Da prendere in carico.", _aperte, Stato.Aperta)
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private DateTime _oggi = DateTime.Today;
    private List<Entry> _inCorso = new();
    private List<Entry> _aperte = new();
    private Stats _stats = new();
    private const int ListLimit = 6;

    private record struct Stats(int Aperte, int InCorso, int MeseCorrente, int Totale);

    protected override async Task OnInitializedAsync()
    {
        SyncState.DataChanged += OnDataChanged;
        await ReloadAsync();
    }

    private async void OnDataChanged() => await InvokeAsync(ReloadAsync);

    private async Task ReloadAsync()
    {
        var all = (await Repo.GetAllAsync()).ToList();
        _stats = new Stats(
            Aperte: all.Count(e => e.Stato == Stato.Aperta),
            InCorso: all.Count(e => e.Stato == Stato.InCorso),
            MeseCorrente: all.Count(e => e.DataRegistrazione.Year == _oggi.Year && e.DataRegistrazione.Month == _oggi.Month),
            Totale: all.Count
        );
        _inCorso = all
            .Where(e => e.Stato == Stato.InCorso)
            .OrderByDescending(e => e.DataRegistrazione)
            .Take(ListLimit)
            .ToList();
        _aperte = all
            .Where(e => e.Stato == Stato.Aperta)
            .OrderByDescending(e => e.DataRegistrazione)
            .Take(ListLimit)
            .ToList();
        StateHasChanged();
    }

    private RenderFragment RenderList(string title, string subtitle, List<Entry> items, Stato stato) => __builder =>
    {
        <MudPaper Class="tt-card pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <div>
                    <MudText Typo="Typo.h6">@title</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@subtitle</MudText>
                </div>
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           EndIcon="@Icons.Material.Outlined.ArrowForward"
                           OnClick="@(() => Nav.NavigateTo($"entries?stato={stato}"))">
                    Tutte
                </MudButton>
            </MudStack>
            @if (items.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary py-2">Nessuna attività in questo stato.</MudText>
            }
            else
            {
                <MudList T="Entry" Dense="true" Class="pa-0">
                    @foreach (var e in items)
                    {
                        <MudListItem T="Entry" OnClick="@(() => Nav.NavigateTo($"entries?id={e.Id}"))">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <MudText Typo="Typo.body2" Style="min-width: 130px;" Class="mud-text-secondary text-truncate">@e.Cliente</MudText>
                                <MudText Typo="Typo.body2" Style="min-width: 140px;" Class="text-truncate">@e.Area</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary text-truncate" Style="flex:1;">@FirstLine(e.Descrizione)</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@e.DataRegistrazione.ToString("dd/MM")</MudText>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    };

    private static string FirstLine(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return string.Empty;
        var nl = s.IndexOf('\n');
        return nl > 0 ? s[..nl] : s;
    }

    public void Dispose() => SyncState.DataChanged -= OnDataChanged;
}
