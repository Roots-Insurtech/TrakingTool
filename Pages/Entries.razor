@page "/entries"
@inject IEntryRepository Repo
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject SyncStateService SyncState
@inject ILocalStorageService LocalStorage
@inject EntryEditor Editor
@inject ReleaseRemindersService Reminders
@implements IDisposable

<PageTitle>TrakingTool — Attività</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h4">Attività</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton StartIcon="@Icons.Material.Outlined.UploadFile" Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("import"))">
                Importa
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Outlined.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">
                Nuova
            </MudButton>
        </MudStack>
    </MudStack>

    <MudPaper Class="tt-card pa-3">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField T="string"
                          Value="_search"
                          ValueChanged="OnSearchChanged"
                          Placeholder="Cerca cliente, area, testo…"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="1"
                          Clearable="true"
                          Immediate="true"
                          DebounceInterval="200"
                          Style="max-width: 320px;" />
            <MudSelect T="Stato?"
                       Value="_statoFilter"
                       ValueChanged="OnStatoChanged"
                       Placeholder="Tutti gli stati"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width: 200px; flex: 1 1 160px;">
                @foreach (var s in Enum.GetValues<Stato>())
                {
                    <MudSelectItem T="Stato?" Value="@(s)">@s.ToLabel()</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int?"
                       Value="_yearFilter"
                       ValueChanged="OnYearChanged"
                       Placeholder="Tutti gli anni"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="max-width: 160px; flex: 1 1 130px;">
                @foreach (var y in _availableYears)
                {
                    <MudSelectItem T="int?" Value="@(y)">@y</MudSelectItem>
                }
            </MudSelect>
            @if (!string.IsNullOrEmpty(_monthFilter))
            {
                <MudChip T="string"
                         Color="Color.Primary"
                         Size="Size.Small"
                         OnClose="ClearMonthFilter"
                         CloseIcon="@Icons.Material.Outlined.Close">
                    Mese: @FormatMonthLabel(_monthFilter)
                </MudChip>
            }
            <MudSpacer />
            @if (HasActiveFilters)
            {
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           StartIcon="@Icons.Material.Outlined.FilterAltOff"
                           OnClick="ResetFiltersAsync">
                    Pulisci filtri
                </MudButton>
            }
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_filtered.Count / @_all.Count</MudText>
        </MudStack>
    </MudPaper>

    <MudPaper Class="tt-card" Style="overflow-x: auto; max-width: 100%;">
        <MudTable T="Entry"
                  Items="_filtered"
                  Hover="true"
                  Dense="true"
                  Striped="false"
                  Breakpoint="Breakpoint.None"
                  Class="pa-0"
                  Style="min-width: 720px;"
                  RowClass="cursor-pointer"
                  OnRowClick="@OnRowClick"
                  SortLabel="Ordina per">
            <HeaderContent>
                <MudTh Style="width: 110px;">
                    <MudTableSortLabel SortBy="@(new Func<Entry, object>(e => (int)e.Stato))">Stato</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="@(new Func<Entry, object>(e => e.Cliente ?? string.Empty))">Cliente</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="@(new Func<Entry, object>(e => e.Area ?? string.Empty))">Area</MudTableSortLabel>
                </MudTh>
                <MudTh>Descrizione</MudTh>
                <MudTh Style="width: 110px;">
                    <MudTableSortLabel InitialDirection="SortDirection.Descending"
                                       SortBy="@(new Func<Entry, object>(e => e.DataRegistrazione))">Registrata</MudTableSortLabel>
                </MudTh>
                <MudTh Style="width: 110px;">
                    <MudTableSortLabel SortBy="@(new Func<Entry, object>(e => (object?)e.DataRilascio ?? DateOnly.MinValue))">Rilasciata</MudTableSortLabel>
                </MudTh>
                <MudTh Style="width: 140px;"></MudTh>
            </HeaderContent>
            <RowTemplate Context="e">
                <MudTd DataLabel="Stato"><MudChip T="string" Size="Size.Small" Class="@e.Stato.ToCssClass()">@e.Stato.ToLabel()</MudChip></MudTd>
                <MudTd DataLabel="Cliente">@e.Cliente</MudTd>
                <MudTd DataLabel="Area">@e.Area</MudTd>
                <MudTd DataLabel="Descrizione" Class="text-truncate" Style="max-width: 360px;">@FirstLine(e.Descrizione)</MudTd>
                <MudTd DataLabel="Registrata">@e.DataRegistrazione.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Rilasciata">@(e.DataRilascio?.ToString("dd/MM/yyyy") ?? "—")</MudTd>
                <MudTd DataLabel="Azioni">
                    <span @onclick:stopPropagation="true">
                        @if (e.Stato.IsOpen())
                        {
                            <MudTooltip Text="Rilascia (oggi)">
                                <MudIconButton Icon="@Icons.Material.Outlined.TaskAlt"
                                               Size="Size.Small"
                                               OnClick="@(async () => await QuickReleaseAsync(e))" />
                            </MudTooltip>
                            <MudTooltip Text="Chiudi">
                                <MudIconButton Icon="@Icons.Material.Outlined.Done"
                                               Size="Size.Small"
                                               OnClick="@(async () => await QuickCloseAsync(e))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Elimina">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Size="Size.Small"
                                           OnClick="@(async () => await DeleteAsync(e))" />
                        </MudTooltip>
                    </span>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="mud-text-secondary py-6">Nessuna attività trovata.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    [SupplyParameterFromQuery(Name = "id")] public Guid? IdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "new")] public string? NewQuery { get; set; }
    [SupplyParameterFromQuery(Name = "stato")] public string? StatoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "month")] public string? MonthQuery { get; set; }
    [SupplyParameterFromQuery(Name = "year")] public int? YearQuery { get; set; }

    private const string FiltersKey = "tt-entries-filters";

    private List<Entry> _all = new();
    private string _search = string.Empty;
    private Stato? _statoFilter;
    private int? _yearFilter;
    private string? _monthFilter;
    private bool _filtersLoaded;
    private Guid? _lastDialogForId;

    private record EntriesFilters(string Search, Stato? Stato, int? Year);

    private IReadOnlyList<int> _availableYears =>
        _all.Select(e => e.DataRegistrazione.Year).Distinct().OrderByDescending(y => y).ToList();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search)
        || _statoFilter.HasValue
        || _yearFilter.HasValue
        || !string.IsNullOrEmpty(_monthFilter);

    private IReadOnlyList<Entry> _filtered =>
        _all.Where(e =>
                (!_statoFilter.HasValue || e.Stato == _statoFilter.Value) &&
                (!_yearFilter.HasValue || e.DataRegistrazione.Year == _yearFilter.Value) &&
                (string.IsNullOrEmpty(_monthFilter) ||
                    $"{e.DataRegistrazione.Year:D4}-{e.DataRegistrazione.Month:D2}" == _monthFilter) &&
                (string.IsNullOrWhiteSpace(_search) ||
                 e.Cliente.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                 e.Area.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                 e.Descrizione.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        SyncState.DataChanged += OnDataChanged;
        var persisted = await LocalStorage.GetItemAsync<EntriesFilters>(FiltersKey);
        if (persisted is not null)
        {
            _search = persisted.Search ?? string.Empty;
            _statoFilter = persisted.Stato;
            _yearFilter = persisted.Year;
        }
        _filtersLoaded = true;
        ApplyQueryOverrides();
        await ReloadAsync();

        if (NewQuery == "1")
        {
            await OpenCreate();
        }
        else if (IdQuery is { } id && _lastDialogForId != id)
        {
            _lastDialogForId = id;
            var entry = _all.FirstOrDefault(e => e.Id == id);
            if (entry is not null) await OpenEdit(entry);
        }
    }

    protected override void OnParametersSet()
    {
        if (_filtersLoaded) ApplyQueryOverrides();
    }

    private void ApplyQueryOverrides()
    {
        if (!string.IsNullOrEmpty(StatoQuery) && Enum.TryParse<Stato>(StatoQuery, true, out var s))
            _statoFilter = s;
        if (YearQuery.HasValue) _yearFilter = YearQuery;
        _monthFilter = string.IsNullOrEmpty(MonthQuery) ? null : MonthQuery;
    }

    private async void OnDataChanged() => await InvokeAsync(ReloadAsync);

    private async Task ReloadAsync()
    {
        _all = (await Repo.GetAllAsync()).ToList();
        StateHasChanged();
    }

    private async Task OnSearchChanged(string val)
    {
        _search = val ?? string.Empty;
        await PersistFiltersAsync();
    }

    private async Task OnStatoChanged(Stato? val)
    {
        _statoFilter = val;
        await PersistFiltersAsync();
    }

    private async Task OnYearChanged(int? val)
    {
        _yearFilter = val;
        await PersistFiltersAsync();
    }

    private void ClearMonthFilter()
    {
        _monthFilter = null;
        // rimuovi il query param navigando a /entries puro
        Nav.NavigateTo("entries");
    }

    private async Task ResetFiltersAsync()
    {
        _search = string.Empty;
        _statoFilter = null;
        _yearFilter = null;
        _monthFilter = null;
        await PersistFiltersAsync();
        // pulisce anche eventuali query param (stato/month/year)
        Nav.NavigateTo("entries");
    }

    private async Task PersistFiltersAsync()
    {
        if (!_filtersLoaded) return;
        await LocalStorage.SetItemAsync(FiltersKey, new EntriesFilters(_search, _statoFilter, _yearFilter));
    }

    private async Task OpenCreate()
    {
        if (await Editor.CreateAsync(_all)) await ReloadAsync();
    }

    private async Task OpenEdit(Entry entry)
    {
        if (await Editor.EditAsync(entry, _all)) await ReloadAsync();
    }

    private async Task OnRowClick(TableRowClickEventArgs<Entry> args)
    {
        if (args.Item is not null) await OpenEdit(args.Item);
    }

    private async Task DeleteAsync(Entry entry)
    {
        var confirm = await Dialog.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Eliminare attività?",
            Message = $"\"{(string.IsNullOrEmpty(entry.Area) ? entry.Cliente : entry.Area)}\" verrà rimossa.",
            YesText = "Elimina",
            CancelText = "Annulla"
        });
        if (confirm == true)
        {
            await Repo.DeleteAsync(entry.Id);
            Snackbar.Add(SyncState.GetSaveResultMessage("Attività eliminata"), SeverityFromState());
            await ReloadAsync();
        }
    }

    private async Task QuickCloseAsync(Entry e)
    {
        var copy = CopyEntry(e);
        copy.Stato = Stato.Chiusa;
        await Repo.SaveAsync(copy);
        await Reminders.AddAsync(e.Cliente, e.Area, e.Id);
        var label = string.IsNullOrEmpty(e.Area) ? e.Cliente : e.Area;
        Snackbar.Add(SyncState.GetSaveResultMessage($"\"{label}\" chiusa"), SeverityFromState());
        await ReloadAsync();
    }

    private async Task QuickReleaseAsync(Entry e)
    {
        var copy = CopyEntry(e);
        copy.Stato = Stato.Rilasciata;
        if (!copy.DataRilascio.HasValue)
            copy.DataRilascio = DateOnly.FromDateTime(DateTime.Today);
        await Repo.SaveAsync(copy);
        // se l'attività rilasciata era ancora "ricordata" come da rilasciare, pulisci il promemoria.
        await Reminders.DismissByAreaAsync(e.Cliente, e.Area);
        var label = string.IsNullOrEmpty(e.Area) ? e.Cliente : e.Area;
        Snackbar.Add(SyncState.GetSaveResultMessage($"\"{label}\" rilasciata"), SeverityFromState());
        await ReloadAsync();
    }

    private Severity SeverityFromState() => SyncState.Status switch
    {
        SyncStatus.Offline => Severity.Info,
        SyncStatus.Error   => Severity.Warning,
        _ => Severity.Success
    };

    private static Entry CopyEntry(Entry e) => new()
    {
        Id = e.Id,
        Cliente = e.Cliente,
        Area = e.Area,
        Stato = e.Stato,
        Descrizione = e.Descrizione,
        DataRegistrazione = e.DataRegistrazione,
        DataRilascio = e.DataRilascio,
        LastModified = e.LastModified
    };

    private static string FirstLine(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return string.Empty;
        var nl = s.IndexOf('\n');
        return nl > 0 ? s[..nl] : s;
    }

    private static string FormatMonthLabel(string yyyyMM)
    {
        if (DateTime.TryParseExact(yyyyMM, "yyyy-MM", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var dt))
            return dt.ToString("MMMM yyyy");
        return yyyyMM;
    }

    public void Dispose() => SyncState.DataChanged -= OnDataChanged;
}
