@page "/"
@inject IEntryRepository Repo
@inject NavigationManager Nav
@inject SyncStateService SyncState
@inject EntryEditor Editor
@inject ReleaseRemindersService Reminders
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>TrakingTool — Dashboard</PageTitle>

<MudStack Spacing="6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h4">Dashboard</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_oggi.ToString("dddd d MMMM yyyy")</MudText>
        </div>
        <MudButton StartIcon="@Icons.Material.Outlined.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">
            Nuova attività
        </MudButton>
    </MudStack>

    <MudGrid>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="tt-card tt-stat-card pa-4" @onclick="@(() => Nav.NavigateTo("entries?stato=Aperta"))">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Aperte</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_stats.Aperte</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="tt-card tt-stat-card pa-4" @onclick="@(() => Nav.NavigateTo("entries?stato=InCorso"))">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">In corso</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_stats.InCorso</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="tt-card tt-stat-card pa-4" @onclick="@(() => Nav.NavigateTo($"entries?month={_oggi:yyyy-MM}"))">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Mese corrente</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_stats.MeseCorrente</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <MudPaper Class="tt-card tt-stat-card pa-4" @onclick="@(() => Nav.NavigateTo("entries"))">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Totale</MudText>
                <MudText Typo="Typo.h4" Class="mt-1">@_stats.Totale</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @RenderList("In corso", "Riprendi da dove avevi lasciato.", _inCorso, Stato.InCorso)
    @RenderList("Aperte", "Da prendere in carico.", _aperte, Stato.Aperta)
</MudStack>

@code {
    private DateTime _oggi = DateTime.Today;
    private List<Entry> _all = new();
    private List<Entry> _inCorso = new();
    private List<Entry> _aperte = new();
    private Stats _stats = new();
    private const int ListLimit = 6;

    private record struct Stats(int Aperte, int InCorso, int MeseCorrente, int Totale);

    protected override async Task OnInitializedAsync()
    {
        SyncState.DataChanged += OnDataChanged;
        await ReloadAsync();
    }

    private async void OnDataChanged() => await InvokeAsync(ReloadAsync);

    private async Task ReloadAsync()
    {
        _all = (await Repo.GetAllAsync()).ToList();
        _stats = new Stats(
            Aperte: _all.Count(e => e.Stato == Stato.Aperta),
            InCorso: _all.Count(e => e.Stato == Stato.InCorso),
            MeseCorrente: _all.Count(e => e.DataRegistrazione.Year == _oggi.Year && e.DataRegistrazione.Month == _oggi.Month),
            Totale: _all.Count
        );
        _inCorso = _all
            .Where(e => e.Stato == Stato.InCorso)
            .OrderByDescending(e => e.DataRegistrazione)
            .Take(ListLimit)
            .ToList();
        _aperte = _all
            .Where(e => e.Stato == Stato.Aperta)
            .OrderByDescending(e => e.DataRegistrazione)
            .Take(ListLimit)
            .ToList();
        StateHasChanged();
    }

    private async Task OpenCreate()
    {
        if (await Editor.CreateAsync(_all)) await ReloadAsync();
    }

    private async Task OpenEdit(Entry e)
    {
        if (await Editor.EditAsync(e, _all)) await ReloadAsync();
    }

    private async Task PromoteToInCorsoAsync(Entry e)
    {
        var copy = CopyEntry(e);
        copy.Stato = Stato.InCorso;
        await Repo.SaveAsync(copy);
        var label = string.IsNullOrEmpty(e.Area) ? e.Cliente : e.Area;
        Snackbar.Add(SyncState.GetSaveResultMessage($"\"{label}\" avviata"), SeverityFromState());
        await ReloadAsync();
    }

    private async Task CloseFromHomeAsync(Entry e)
    {
        var copy = CopyEntry(e);
        copy.Stato = Stato.Chiusa;
        await Repo.SaveAsync(copy);
        await Reminders.AddAsync(e.Cliente, e.Area, e.Id);
        var label = string.IsNullOrEmpty(e.Area) ? e.Cliente : e.Area;
        Snackbar.Add(SyncState.GetSaveResultMessage($"\"{label}\" chiusa"), SeverityFromState());
        await ReloadAsync();
    }

    private Severity SeverityFromState() => SyncState.Status switch
    {
        SyncStatus.Offline => Severity.Info,
        SyncStatus.Error   => Severity.Warning,
        _ => Severity.Success
    };

    private static Entry CopyEntry(Entry e) => new()
    {
        Id = e.Id,
        Cliente = e.Cliente,
        Area = e.Area,
        Stato = e.Stato,
        Descrizione = e.Descrizione,
        DataRegistrazione = e.DataRegistrazione,
        DataRilascio = e.DataRilascio,
        LastModified = e.LastModified
    };

    private RenderFragment RenderList(string title, string subtitle, List<Entry> items, Stato stato) => __builder =>
    {
        <MudPaper Class="tt-card pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <div>
                    <MudText Typo="Typo.h6">@title</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@subtitle</MudText>
                </div>
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           EndIcon="@Icons.Material.Outlined.ArrowForward"
                           OnClick="@(() => Nav.NavigateTo($"entries?stato={stato}"))">
                    Tutte
                </MudButton>
            </MudStack>
            @if (items.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary py-2">Nessuna attività in questo stato.</MudText>
            }
            else
            {
                <MudList T="Entry" Dense="true" Class="pa-0 tt-home-list">
                    @foreach (var e in items)
                    {
                        <MudListItem T="Entry" OnClick="@(() => OpenEdit(e))">
                            <MudStack Spacing="0" Class="tt-home-list-item">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2" Class="text-truncate" Style="flex: 1; min-width: 0;">
                                        <strong>@(string.IsNullOrEmpty(e.Cliente) ? "—" : e.Cliente)</strong>
                                        <span class="mud-text-secondary"> · @(string.IsNullOrEmpty(e.Area) ? "—" : e.Area)</span>
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="flex-shrink: 0;">@e.DataRegistrazione.ToString("dd/MM")</MudText>
                                    <span @onclick:stopPropagation="true" class="tt-home-quick">
                                        @if (stato == Stato.Aperta)
                                        {
                                            <MudTooltip Text="Avvia (passa in corso)">
                                                <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow"
                                                               Size="Size.Small"
                                                               OnClick="@(async () => await PromoteToInCorsoAsync(e))" />
                                            </MudTooltip>
                                        }
                                        else if (stato == Stato.InCorso)
                                        {
                                            <MudTooltip Text="Chiudi">
                                                <MudIconButton Icon="@Icons.Material.Outlined.Done"
                                                               Size="Size.Small"
                                                               OnClick="@(async () => await CloseFromHomeAsync(e))" />
                                            </MudTooltip>
                                        }
                                    </span>
                                </MudStack>
                                @if (!string.IsNullOrWhiteSpace(e.Descrizione))
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary text-truncate" Style="max-width: 100%;">@FirstLine(e.Descrizione)</MudText>
                                }
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    };

    private static string FirstLine(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return string.Empty;
        var nl = s.IndexOf('\n');
        return nl > 0 ? s[..nl] : s;
    }

    public void Dispose() => SyncState.DataChanged -= OnDataChanged;
}
