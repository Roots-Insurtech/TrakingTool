@page "/settings"

<PageTitle>TrakingTool — Impostazioni</PageTitle>

<MudStack Spacing="4">
    <MudText Typo="Typo.h4">Impostazioni</MudText>

    <MudPaper Class="tt-card pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">Account</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">L'integrazione Microsoft / OneDrive sarà configurata nel prossimo step.</MudText>
    </MudPaper>

    <MudPaper Class="tt-card pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">Storage</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Modalità attuale: cache locale (LocalStorage). I dati sono memorizzati solo su questo dispositivo finché non viene attivato il sync OneDrive.</MudText>
    </MudPaper>
</MudStack>
